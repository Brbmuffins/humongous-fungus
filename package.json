{
  "name": "fungus-games",
  "private": true,
  "version": "0.1.0",
  "description": "Two mobile games: Humongous Fungus (idle terrarium) and Sporemonger (mushroom market trading).",
  "type": "module",
  "scripts": {
    "dev": "GAME=fungus vite --host",
    "dev:sporemonger": "GAME=sporemonger vite --host",
    "build": "tsc --noEmit && GAME=fungus vite build && GAME=sporemonger vite build",
    "build:artifact": "npm run build && node scripts/make-artifact.mjs fungus && node scripts/make-artifact.mjs sporemonger",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx scripts/simulate.ts"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/gluten": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "workspaces": [
    "games/fungus",
    "games/sporemonger"
  ]
}
